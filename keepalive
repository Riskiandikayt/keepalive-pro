    echo -e "${BOLD}${WHITE}PERINTAH:${RESET}"
    echo ""
    echo -e "  ${GREEN}keepalive start${RESET}                    Jalankan di background"
    echo -e "  ${GREEN}keepalive stop${RESET}                     Hentikan script"
    echo -e "  ${GREEN}keepalive restart${RESET}                  Restart script"
    echo -e "  ${GREEN}keepalive status${RESET}                   Lihat status & website"
    echo -e "  ${GREEN}keepalive log${RESET}                      Lihat log terbaru"
    echo -e "  ${GREEN}keepalive log -n 50${RESET}                Lihat 50 baris log terakhir"
    echo -e "  ${GREEN}keepalive log clear${RESET}                Hapus semua log"
