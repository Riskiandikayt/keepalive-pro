#!/data/data/com.termux/files/usr/bin/bash
# ============================================================
#  KEEPALIVE CLI — Command Line Interface
#  Usage: keepalive <command> [options]
# ============================================================

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CONFIG="$SCRIPT_DIR/config.sh"
MAIN="$SCRIPT_DIR/main.sh"
PID_FILE="$SCRIPT_DIR/.keepalive.pid"
LOG_FILE="$SCRIPT_DIR/logs.txt"

# Warna
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
WHITE='\033[1;37m'
DIM='\033[2m'
BOLD='\033[1m'
RESET='\033[0m'

